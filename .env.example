# Copie este archivo como ".env" y escriba sus datos reales.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).

# Motor de base de datos: "mysql" (recomendado) o "sqlite" (prueba rapida, sin instalar nada)
DB_TIPO=mysql

# Datos de MySQL (solo se usan si DB_TIPO=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=escriba_su_contrasena_aqui
DB_NAME=clinica_db
